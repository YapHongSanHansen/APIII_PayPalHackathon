# Copy to .env.local. Everything is optional for a first local run:
# without PayPal keys the app runs in PayPal "mock" mode, without OpenAI it uses heuristics,
# without DATABASE_URL it uses an embedded Postgres (PGlite) in .data/.

# --- PayPal sandbox (developer.paypal.com → Apps & Credentials, Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# --- OpenAI (platform.openai.com API key, NOT a ChatGPT subscription) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Database (optional; Neon/Supabase Postgres). Empty = embedded PGlite ---
DATABASE_URL=

# --- Secrets (optional in dev: generated into .data/ automatically; REQUIRED in production) ---
APIII_SEAL_KEY=          # openssl rand -base64 32
APIII_RECEIPT_SK=        # Ed25519 private key PEM (use \n for newlines)

# --- App ---
APP_URL=http://localhost:3000
# APIII_ALLOW_PRIVATE_UPSTREAMS=true   # default: true in dev, false in production

# --- Demo seller (Deal Finder) ---
CHANNEL3_API_KEY=        # promo code PAYPAL-HACKATHON-2026
CHANNEL3_API_URL=        # override if Channel3's search endpoint differs
DEMO_SELLER_KEY=demo-secret-key
